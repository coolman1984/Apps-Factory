{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Apps Factory Creative Recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "profile",
    "target",
    "use_case",
    "engine",
    "layers",
    "timeline",
    "accessibility",
    "perf",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "profile": {
      "enum": [
        "essential",
        "polished",
        "cinematic",
        "film"
      ]
    },
    "target": {
      "enum": [
        "desktop",
        "lan",
        "marketing",
        "film",
        "3d"
      ]
    },
    "use_case": {
      "type": "string",
      "minLength": 10
    },
    "engine": {
      "type": "string"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "depth"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "depth": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "timeline": {
      "type": "object",
      "required": [
        "duration_ms",
        "trigger",
        "loop"
      ],
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "trigger": {
          "type": "string"
        },
        "loop": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "accessibility": {
      "type": "object",
      "required": [
        "reduced_motion",
        "keyboard",
        "rtl"
      ],
      "properties": {
        "reduced_motion": {
          "type": "string"
        },
        "keyboard": {
          "type": "boolean"
        },
        "rtl": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "perf": {
      "type": "object",
      "required": [
        "webgl",
        "external_runtime",
        "max_simultaneously_animated"
      ],
      "properties": {
        "webgl": {
          "type": "boolean"
        },
        "external_runtime": {
          "type": "boolean"
        },
        "max_simultaneously_animated": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
