{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coolman1984/Apps-Factory/blob/main/company-os/task.schema.json",
  "title": "Pixel Plus AI Company Work Handoff v0.3 (non-authorizing)",
  "description": "Strict cross-account handoff metadata, not a real-world approval. Both the schema and company-os/validate_task.py MUST be applied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "goal",
    "project",
    "department",
    "assignee",
    "reviewer",
    "risk",
    "status",
    "budget_usd",
    "allowed_actions",
    "acceptance",
    "evidence",
    "requires_owner_approval",
    "decision_ref",
    "customer_data_policy",
    "open_prs",
    "known_errors",
    "tests_run",
    "tests_skipped",
    "current_commit",
    "branch",
    "next_action"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^PX-[0-9]{3,6}$"
    },
    "goal": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "project": {
      "type": "string",
      "minLength": 2
    },
    "department": {
      "type": "string",
      "enum": [
        "engineering",
        "qa-security",
        "research",
        "design",
        "marketing",
        "sales",
        "finance",
        "support",
        "management"
      ]
    },
    "assignee": {
      "type": "string",
      "minLength": 2,
      "pattern": "\\S"
    },
    "reviewer": {
      "type": "string",
      "minLength": 2,
      "pattern": "\\S"
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "backlog",
        "ready",
        "working",
        "review",
        "owner_gate",
        "blocked",
        "done"
      ]
    },
    "budget_usd": {
      "type": "number",
      "minimum": 0
    },
    "time_cap_minutes": {
      "type": "integer",
      "minimum": 0
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "requires_owner_approval": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "reference"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "commit",
              "pr",
              "ci",
              "screenshot",
              "field",
              "source",
              "customer_acceptance"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 3,
            "pattern": "\\S"
          },
          "verified_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:0\\d|1[0-4]):[0-5]\\d)$"
          }
        }
      }
    },
    "blocker": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_action": {
      "type": "string",
      "minLength": 8,
      "pattern": "\\S"
    },
    "current_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{7,40}$"
    },
    "customer_data_policy": {
      "type": "string",
      "enum": [
        "synthetic_only",
        "approved_read_only",
        "none"
      ]
    },
    "decision_ref": {
      "type": "string",
      "pattern": "^(?:docs/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.md|DECISIONS\\.md|https://[A-Za-z0-9.-]+\\.[A-Za-z]{2,}(?::[0-9]{2,5})?/[A-Za-z0-9_./?&=%#-]+)$",
      "minLength": 7
    },
    "branch": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 2,
      "pattern": "^[^\\s]+$"
    },
    "open_prs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 8,
        "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+/pull/[1-9][0-9]*$"
      },
      "uniqueItems": true
    },
    "known_errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 4
      },
      "uniqueItems": true
    },
    "tests_run": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "uniqueItems": true
    },
    "tests_skipped": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "done"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1,
            "contains": {
              "type": "object",
              "required": [
                "verified_at"
              ],
              "properties": {
                "verified_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "owner_gate"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "requires_owner_approval": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
